# Dockerfile for Gemini CLI OpenAI Worker (Production with Bun)

# ---- Environment Arguments ----
# Define arguments that can be passed during the build process.
# These are populated from the .env file via docker-compose.
ARG GCP_SERVICE_ACCOUNT
ARG GEMINI_PROJECT_ID
ARG OPENAI_API_KEY
ARG ENABLE_FAKE_THINKING
ARG ENABLE_REAL_THINKING
ARG STREAM_THINKING_AS_CONTENT
ARG ENABLE_AUTO_MODEL_SWITCHING
ARG GEMINI_MODERATION_HARASSMENT_THRESHOLD
ARG GEMINI_MODERATION_HATE_SPEECH_THRESHOLD
ARG GEMINI_MODERATION_SEXUALLY_EXPLICIT_THRESHOLD
ARG GEMINI_MODERATION_DANGEROUS_CONTENT_THRESHOLD
ARG ENABLE_GEMINI_NATIVE_TOOLS
ARG ENABLE_GOOGLE_SEARCH
ARG ENABLE_URL_CONTEXT
ARG GEMINI_TOOLS_PRIORITY
ARG DEFAULT_TO_NATIVE_TOOLS
ARG ALLOW_REQUEST_TOOL_CONTROL
ARG ENABLE_INLINE_CITATIONS
ARG INCLUDE_GROUNDING_METADATA
ARG INCLUDE_SEARCH_ENTRY_POINT

# ---- Base Stage ----
# Start with a slim base image for a smaller footprint
FROM oven/bun:1.0-slim AS base

# ---- Builder Stage ----
# This stage installs dependencies and builds the application
FROM base AS builder
WORKDIR /app

# Copy package files and install dependencies with bun
COPY package.json bun.lock ./
RUN bun install

# Copy the rest of the application source code
COPY . .

# Build the application with bun
# The ARG declarations need to be repeated here to be accessible in this build stage.
ARG GCP_SERVICE_ACCOUNT
ARG GEMINI_PROJECT_ID
ARG OPENAI_API_KEY
ARG ENABLE_FAKE_THINKING
ARG ENABLE_REAL_THINKING
ARG STREAM_THINKING_AS_CONTENT
ARG ENABLE_AUTO_MODEL_SWITCHING
ARG GEMINI_MODERATION_HARASSMENT_THRESHOLD
ARG GEMINI_MODERATION_HATE_SPEECH_THRESHOLD
ARG GEMINI_MODERATION_SEXUALLY_EXPLICIT_THRESHOLD
ARG GEMINI_MODERATION_DANGEROUS_CONTENT_THRESHOLD
ARG ENABLE_GEMINI_NATIVE_TOOLS
ARG ENABLE_GOOGLE_SEARCH
ARG ENABLE_URL_CONTEXT
ARG GEMINI_TOOLS_PRIORITY
ARG DEFAULT_TO_NATIVE_TOOLS
ARG ALLOW_REQUEST_TOOL_CONTROL
ARG ENABLE_INLINE_CITATIONS
ARG INCLUDE_GROUNDING_METADATA
ARG INCLUDE_SEARCH_ENTRY_POINT
RUN bun run build

# ---- Production Stage ----
# This is the final, optimized image
FROM base AS production

# Re-declare the arguments in this stage so they can be used by the ENV instructions.
ARG GCP_SERVICE_ACCOUNT
ARG GEMINI_PROJECT_ID
ARG OPENAI_API_KEY
ARG ENABLE_FAKE_THINKING
ARG ENABLE_REAL_THINKING
ARG STREAM_THINKING_AS_CONTENT
ARG ENABLE_AUTO_MODEL_SWITCHING
ARG GEMINI_MODERATION_HARASSMENT_THRESHOLD
ARG GEMINI_MODERATION_HATE_SPEECH_THRESHOLD
ARG GEMINI_MODERATION_SEXUALLY_EXPLICIT_THRESHOLD
ARG GEMINI_MODERATION_DANGEROUS_CONTENT_THRESHOLD
ARG ENABLE_GEMINI_NATIVE_TOOLS
ARG ENABLE_GOOGLE_SEARCH
ARG ENABLE_URL_CONTEXT
ARG GEMINI_TOOLS_PRIORITY
ARG DEFAULT_TO_NATIVE_TOOLS
ARG ALLOW_REQUEST_TOOL_CONTROL
ARG ENABLE_INLINE_CITATIONS
ARG INCLUDE_GROUNDING_METADATA
ARG INCLUDE_SEARCH_ENTRY_POINT

# Set environment variables from the build arguments
# This makes the variables available to the application at runtime.
ENV GCP_SERVICE_ACCOUNT=$GCP_SERVICE_ACCOUNT
ENV GEMINI_PROJECT_ID=$GEMINI_PROJECT_ID
ENV OPENAI_API_KEY=$OPENAI_API_KEY
ENV ENABLE_FAKE_THINKING=$ENABLE_FAKE_THINKING
ENV ENABLE_REAL_THINKING=$ENABLE_REAL_THINKING
ENV STREAM_THINKING_AS_CONTENT=$STREAM_THINKING_AS_CONTENT
ENV ENABLE_AUTO_MODEL_SWITCHING=$ENABLE_AUTO_MODEL_SWITCHING
ENV GEMINI_MODERATION_HARASSMENT_THRESHOLD=$GEMINI_MODERATION_HARASSMENT_THRESHOLD
ENV GEMINI_MODERATION_HATE_SPEECH_THRESHOLD=$GEMINI_MODERATION_HATE_SPEECH_THRESHOLD
ENV GEMINI_MODERATION_SEXUALLY_EXPLICIT_THRESHOLD=$GEMINI_MODERATION_SEXUALLY_EXPLICIT_THRESHOLD
ENV GEMINI_MODERATION_DANGEROUS_CONTENT_THRESHOLD=$GEMINI_MODERATION_DANGEROUS_CONTENT_THRESHOLD
ENV ENABLE_GEMINI_NATIVE_TOOLS=$ENABLE_GEMINI_NATIVE_TOOLS
ENV ENABLE_GOOGLE_SEARCH=$ENABLE_GOOGLE_SEARCH
ENV ENABLE_URL_CONTEXT=$ENABLE_URL_CONTEXT
ENV GEMINI_TOOLS_PRIORITY=$GEMINI_TOOLS_PRIORITY
ENV DEFAULT_TO_NATIVE_TOOLS=$DEFAULT_TO_NATIVE_TOOLS
ENV ALLOW_REQUEST_TOOL_CONTROL=$ALLOW_REQUEST_TOOL_CONTROL
ENV ENABLE_INLINE_CITATIONS=$ENABLE_INLINE_CITATIONS
ENV INCLUDE_GROUNDING_METADATA=$INCLUDE_GROUNDING_METADATA
ENV INCLUDE_SEARCH_ENTRY_POINT=$INCLUDE_SEARCH_ENTRY_POINT

# Create a non-root user for enhanced security
# RUN groupadd -g 1001 bun && \
#     useradd -r -u 1001 -g bun bun

WORKDIR /app

# Copy built artifacts and production dependencies from the builder stage
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./

# Set correct ownership for the app directory
RUN chown -R bun:bun /app

# Switch to the non-root user
USER bun

EXPOSE 8787

# # Health check to ensure the service is running
# HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
#   CMD curl -f http://localhost:8787/health || exit 1

# Command to run the worker using bun
CMD ["bun", "dist/index.js"]
